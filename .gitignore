# Only the analysis code for the paper is tracked. Everything else in this
# folder (manuscript drafts, co-author corrections, figures...) stays local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/PCB DDE paper.Rproj
!/analysis.qmd
!/R/
!/data/

# Regenerated by the scripts
/output/

# R / RStudio / Quarto
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*_files/

# GADM licence forbids redistribution: download them (see README)
/data/shapefiles/

# Raw data are not public
/data/PCBcorrectedDB.csv
